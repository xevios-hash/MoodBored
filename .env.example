# MoodBored Environment Variables
# Copy to .env and fill in your values. None are required for local use.

# ─── AI Provider API Keys (Server-side only) ────────────────────────
# Configure one or more providers. The server auto-detects based on model prefix.
# All keys are optional — configure only the providers you want to use.

# OpenRouter (default) - Access to 100+ models via single API
OPENROUTER_API_KEY=

# OpenAI - GPT-4, GPT-4 Turbo, GPT-4o
OPENAI_API_KEY=

# Anthropic - Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku
ANTHROPIC_API_KEY=

# Google Gemini - Gemini Pro, Gemini 1.5 Pro/Flash
GEMINI_API_KEY=

# Groq - Ultra-fast inference for Llama 3, Mixtral
GROQ_API_KEY=

# Together AI - Open-source models at scale
TOGETHER_API_KEY=

# Mistral AI - Mistral Large, Medium, Small
MISTRAL_API_KEY=

# Cohere - Command R+, Command R
COHERE_API_KEY=

# Perplexity - Online LLMs with search
PERPLEXITY_API_KEY=

# Fireworks AI - Fast inference for open models
FIREWORKS_API_KEY=

# DeepSeek - DeepSeek Chat, DeepSeek Coder
DEEPSEEK_API_KEY=

# ─── Local Providers (No API key needed) ────────────────────────────

# Ollama - Run models locally (most popular)
OLLAMA_URL=http://localhost:11434

# LM Studio - Local model server
LMSTUDIO_URL=http://localhost:1234

# Custom OpenAI-compatible endpoint (e.g., vLLM, text-generation-webui)
CUSTOM_AI_URL=http://localhost:8080/v1/chat/completions
CUSTOM_AI_KEY=

# ─── Image & Media APIs ─────────────────────────────────────────────

# Unsplash access key (required for image search)
UNSPLASH_ACCESS_KEY=

# ─── Authentication ─────────────────────────────────────────────────

# Board API token (required for mutating board endpoints)
# All PUT/DELETE/POST requests must include: Authorization: Bearer <token>
BOARD_API_TOKEN=

# ─── Supabase (optional — enables cloud sync) ───────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Server configuration ──────────────────────────────────────────
PORT=3000
BOARDS_DIR=

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,https://moodbored-production.up.railway.app

# ─── MCP Server ────────────────────────────────────────────────────
MOODBORED_BOARD_ID=
MOODBORED_BOARDS_DIR=
