# MoodBored Environment Variables
# Copy to .env and fill in your values. None are required for local use.

# ─── Server-side secrets (NEVER expose to client) ───────────────────

# OpenRouter API key (required for AI chat, image gen, semantic search)
# The server reads this and injects it into all OpenRouter calls.
OPENROUTER_API_KEY=

# Unsplash access key (required for image search)
# The server reads this and proxies Unsplash requests.
UNSPLASH_ACCESS_KEY=

# Board API token (required for mutating board endpoints)
# All PUT/DELETE/POST requests must include: Authorization: Bearer <token>
BOARD_API_TOKEN=

# ─── Supabase (optional — enables cloud sync) ───────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Server configuration ──────────────────────────────────────────
PORT=3000
BOARDS_DIR=

# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,https://moodbored-production.up.railway.app

# ─── MCP Server ────────────────────────────────────────────────────
MOODBORED_BOARD_ID=
MOODBORED_BOARDS_DIR=
