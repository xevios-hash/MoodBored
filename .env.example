# MoodBored Environment Variables
# Copy to .env and fill in your values. None are required for local use.

# Supabase (optional — enables cloud sync and collaboration features)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server
PORT=3000
BOARDS_DIR=

# MCP Server (set to target a specific board)
MOODBORED_BOARD_ID=
MOODBORED_BOARDS_DIR=