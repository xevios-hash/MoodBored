{
  "name": "MoodBored",
  "version": "1.0.0",
  "description": "Collaborative mood-board workspace — visual brainstorming canvas that any LLM can drive via MCP tools",
  "capabilities": {
    "tools": {},
    "resources": {}
  },
  "transport": {
    "sse": { "url": "/mcp/sse" },
    "post": { "url": "/mcp" }
  },
  "tools": [
    { "name": "get_board", "description": "Read the full board — items, palette, typography, spatial layout, relationships" },
    { "name": "add_items", "description": "Add one or more items to the board" },
    { "name": "remove_items", "description": "Remove items by ID" },
    { "name": "update_item", "description": "Update item properties" },
    { "name": "search_items", "description": "Text + tag search" },
    { "name": "semantic_search", "description": "Meaning-based search" },
    { "name": "related_items", "description": "Find related items" },
    { "name": "arrange_items", "description": "Grid, stack, spiral layouts" },
    { "name": "clear_board", "description": "Remove all items" }
  ],
  "resources": [
    { "name": "board", "uri": "board://current", "description": "Full board state as JSON" },
    { "name": "summary", "uri": "board://summary", "description": "Text summary of the board" }
  ]
}